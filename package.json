{
  "name": "aurawhisper",
  "version": "1.2.4",
  "description": "Premium dictation tool for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourcompany.aurawhisper",
    "asar": false,
    "files": [
      "**/*.js",
      "**/*.json",
      "ui/**/*",
      "assets/**/*",
      "backend/**/*",
      "!backend/venv/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
