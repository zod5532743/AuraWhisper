{
  "name": "aurawhisper",
  "version": "1.0.1",
  "description": "Premium dictation tool for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourcompany.aurawhisper",
    "files": [
      "**/*.js",
      "**/*.json",
      "backend/*.py",
      "backend/requirements.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
